# 复制本文件为 .env.local 并填入真实值（.env.local 不会提交到 git）

# ====== 基础 ======
SITE_NAME=Felix的工具小铺
NEXT_PUBLIC_SITE_NAME=Felix的工具小铺
NEXT_PUBLIC_SHOP_NOTICE=本店全自动发货，付款后立即到账。\n如付款后未跳转到发货页，可用右上角「订单查询」凭订单号/邮箱找回。

# 右下角「在线客服」按钮链接（QQ群 / Telegram / 企业微信等），留空则不显示
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_SUPPORT_TEXT=在线客服

# ====== 新订单微信通知（任选其一，填了才会推送）======
# PushPlus：https://www.pushplus.plus 微信扫码登录后复制 token（推荐，免费 200 条/天）
PUSHPLUS_TOKEN=
# Server酱：https://sct.ftqq.com 的 SendKey
SERVERCHAN_KEY=
# 企业微信群机器人 webhook 地址
WECOM_WEBHOOK=

# ====== 管理员后台 ======
# 务必改成强密码 + 长随机串
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

# ====== 支付 ======
# mock = 本地模拟支付；jhup = 聚合支付 pay.jhup.cn
PAYMENT_PROVIDER=mock
JHUP_API_URL=https://pay.jhup.cn
JHUP_PID=
JHUP_KEY=
# 公网 https 域名（支付回调/跳转用）
SITE_URL=https://your-domain.com
